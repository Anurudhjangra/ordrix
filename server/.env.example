# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Database (SQLite)
DATABASE_URL=./data/cafe.db

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Payments
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed credentials
SEED_OWNER_EMAIL=owner@ordrix.test
SEED_OWNER_PASSWORD=Owner@12345
SEED_ADMIN_EMAIL=admin@ordrix.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STUDENT_EMAIL=student@mdu.test
SEED_STUDENT_PASSWORD=Student@12345

# Orders
ORDER_ACCEPT_TIMEOUT_MINUTES=10

# Demo
DEMO_AUTO_ADVANCE=false
